{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "engine-debug",
      "displayName": "PhaseWraith engine tests (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/engine-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PHASEWRAITH_BUILD_PLUGIN": "ON",
        "PHASEWRAITH_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "plugin-release",
      "displayName": "PhaseWraith plugin bundles (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/plugin-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PHASEWRAITH_BUILD_PLUGIN": "ON",
        "PHASEWRAITH_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "engine-debug",
      "configurePreset": "engine-debug",
      "targets": [
        "phasewraith_engine_tests",
        "phasewraith_plugin_bridge_tests",
        "phasewraith_standalone_bridge_tests"
      ]
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release",
      "targets": [
        "ehl_stage_products",
        "phasewraith_engine_tests",
        "phasewraith_plugin_bridge_tests",
        "phasewraith_standalone_bridge_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "engine-debug",
      "configurePreset": "engine-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
